 Date_test;D
 D←Lib.Date
 2026 11 16 ExpectEq D.Parse '2026-11-16'
 2026 11 16 9 5 0 ExpectEq D.Parse '2026-11-16 09:05'
 2026 11 16 ExpectEq D.Parse 2026 11 16
 11 ExpectError 'D.Parse ''2026-02-30'''
 11 ExpectError 'D.Parse ''hello'''
 ExpectTrue D.IsValid '2024-02-29'
 ExpectFalse D.IsValid '2026-02-29'
 '2026-01-05' ExpectEq D.Format 2026 1 5
 '2026-01-05 07:08:09' ExpectEq D.Format 2026 1 5 7 8 9
 10 ExpectEq ≢D.Today ⍬
 '2026-11-23' ExpectEq 7 D.AddDays '2026-11-16'
 '2026-03-01' ExpectEq 1 D.AddDays '2026-02-28'
 '2025-12-31' ExpectEq ¯1 D.AddDays '2026-01-01'
 15 ExpectEq '2026-11-01' D.DaysBetween '2026-11-16'
 365 ExpectEq '2025-01-01' D.DaysBetween '2026-01-01'
 'Monday' ExpectEq D.Weekday '2026-11-16'
 'Saturday' ExpectEq D.Weekday '2000-01-01'
 '2026-11' ExpectEq D.Month '2026-11-16'
 ExpectTrue D.IsLeap '2000-01-01'
 ExpectFalse D.IsLeap '1900-01-01'
 29 ExpectEq D.DaysInMonth '2024-02-10'
 28 ExpectEq D.DaysInMonth '2026-02-10'
 30 ExpectEq D.DaysInMonth '2026-11-16'
 31 ExpectEq D.DaysInMonth '2026-12-01'
