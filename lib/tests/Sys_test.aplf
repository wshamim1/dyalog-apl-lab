 Sys_test;f;t
 'fallback' ExpectEq 'fallback' Lib.Sys.Env 'NO_SUCH_VARIABLE_XYZ'
 '' ExpectEq Lib.Sys.Env 'NO_SUCH_VARIABLE_XYZ'
 ExpectTrue 0<≢Lib.Sys.Env 'PATH'
 '2026-01-05 07:08:09' ExpectEq Lib.Sys.ISO 2026 1 5 7 8 9 0
 19 ExpectEq ≢Lib.Sys.Now ⍬
 f←(739⌶0),'/lib_sys_test.txt'
 {}('one',(⎕UCS 10),'two')Lib.Sys.WriteText f
 ExpectTrue Lib.Sys.Exists f
 ('one' 'two') ExpectEq Lib.Sys.ReadLines f
 ⎕NDELETE f
 ExpectFalse Lib.Sys.Exists f
