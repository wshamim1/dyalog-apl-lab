#!/usr/bin/env bash
# `dyalog` command: run Dyalog APL from any folder, using a container.
# For Macs that can't run the native app (e.g. Intel Macs with Dyalog 21).
#
# Usage:
#   dyalog                 APL session in this terminal; current folder at /app
#   dyalog FILE.apls       run an APL script (top to bottom), then exit
#   dyalog FILE.aplf       start a session with that function loaded
#                          (a function without arguments runs straight away)
#                          same for .aplo .apln .aplc .apli .dyalog
#   dyalog FILE.apla       display the array in an array-notation file
#   dyalog FILE.dws        open a saved workspace (runs its ⎕LX)
#   dyalog FILE.dyapp      start an app definition (Load …/Run … lines)
#   dyalog test [PATH]     run *_test.aplf tests under PATH (default: here)
#   dyalog ride            serve RIDE on localhost:4502 (connect RIDE to it)
#   dyalog pull            update the Dyalog image
#   dyalog setup           install/start Podman (or Docker) and pull the image
#   dyalog help
#
# In scripts only ⎕← output is printed: write ⎕←'hello', not just 'hello'.
#
# Env:
#   DYALOG_ENGINE   podman or docker (default: podman if installed, else docker)
#   IMAGE           image (default: docker.io/dyalog/dyalog;
#                   use localhost/dyalog-mysql:latest for the MySQL functions)
#   RIDE_PORT       port for `dyalog ride` (default: 4502)
#
# Install:  install/dyalog/install-cli.sh

set -euo pipefail

# Resolve our real location even when called through a symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$dir/$src"
done
HERE="$(cd "$(dirname "$src")" && pwd)"

if [ -z "${DYALOG_ENGINE:-}" ]; then
  if command -v podman >/dev/null 2>&1; then DYALOG_ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then DYALOG_ENGINE=docker
  else DYALOG_ENGINE=podman   # `dyalog setup` will install it
  fi
fi

die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# run <mount-dir> <container.sh args…>
run() { local m="$1"; shift
        ENGINE="$DYALOG_ENGINE" SELF=dyalog MOUNT_DIR="$m" exec "$HERE/container.sh" "$@"; }

# For a file argument: mount the current folder if the file is inside it
# (so the script can reach its neighbours), otherwise the file's own folder.
# Sets MOUNT and INSIDE (the file's path inside the container).
place_file() {
  local f="$1" abs
  [ -f "$f" ] || die "no such file: $f"
  abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
  case "$abs" in
    "$PWD"/*) MOUNT="$PWD"; INSIDE="/app/${abs#"$PWD"/}" ;;
    *)        MOUNT="$(dirname "$abs")"; INSIDE="/app/$(basename "$abs")" ;;
  esac
}

# Tests: the framework lives in <repo>/testing (Tester.apln, run-tests.apls)
TESTING="$(cd "$HERE/../.." && pwd)/testing"

case "${1:-}" in
  "")              run "$PWD" run ;;
  test)            # dyalog test [folder|file]
    target="${2:-.}"
    [ -e "$target" ] || die "no such file or folder: $target"
    [ -f "$TESTING/run-tests.apls" ] || die "test framework not found in $TESTING"
    if [ -d "$target" ]; then abs="$(cd "$target" && pwd)"
    else abs="$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"; fi
    case "$abs" in
      "$PWD")   MOUNT="$PWD"; INSIDE="/app" ;;
      "$PWD"/*) MOUNT="$PWD"; INSIDE="/app/${abs#"$PWD"/}" ;;
      *) if [ -d "$abs" ]; then MOUNT="$abs"; INSIDE="/app"
         else MOUNT="$(dirname "$abs")"; INSIDE="/app/$(basename "$abs")"; fi ;;
    esac
    EXTRA_MOUNT="$TESTING:/apl-test:ro" run "$MOUNT" script /apl-test/run-tests.apls "$INSIDE" ;;
  ride)            run "$PWD" ride ;;
  pull)            run "$PWD" pull ;;
  setup|install)   run "$PWD" install ;;
  -h|--help|help)  sed -n '2,29p' "$src" | sed 's/^# \{0,1\}//' ;;
  *.apls|*.apla|*.aplf|*.aplo|*.apln|*.aplc|*.apli|*.dyalog|*.dws|*.dyapp)
    place_file "$1"; shift
    case "$INSIDE" in
      *.apls)  run "$MOUNT" script "$INSIDE" "$@" ;;
      *.apla)  [ $# -eq 0 ] || die "arguments are only supported for .apls scripts"
               EXTRA_MOUNT="$HERE:/dyalog-cli:ro" \
                 run "$MOUNT" script /dyalog-cli/show-apla.apls "$INSIDE" ;;
      *.dyapp) [ $# -eq 0 ] || die "arguments are only supported for .apls scripts"
               run "$MOUNT" load "$INSIDE" DYAPP ;;
      *.dws|*.apln|*.aplc|*.apli|*.dyalog)
               [ $# -eq 0 ] || die "arguments are only supported for .apls scripts"
               run "$MOUNT" load "$INSIDE" ;;
      *)      [ $# -eq 0 ] || die "arguments are only supported for .apls scripts"
              # A function file starts with a header (F←{…} or r←F y). If the
              # first real line looks like a statement, it's really a script.
              first="$(grep -v -E '^[[:space:]]*(⍝|$)' "$MOUNT/${INSIDE#/app/}" | head -n 1 || true)"
              stmt_re="^[[:space:]]*['⎕0-9¯(]"
              if [[ "$first" =~ $stmt_re ]]; then
                printf '\033[1;33mhint:\033[0m %s starts with a statement (%s), so it looks like a script.\n      Rename it to .apls, and use ⎕← for anything you want printed.\n' \
                  "$INSIDE" "$first" >&2
              fi
              run "$MOUNT" load "$INSIDE" ;;
    esac
    ;;
  *) [ -f "$1" ] && die "don't know how to run '$1': supported: .apls .apla .aplf .aplo .apln .aplc .apli .dyalog .dws .dyapp"
     die "unknown command '$1' (try: dyalog help)" ;;
esac
